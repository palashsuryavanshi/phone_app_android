#!/bin/sh
#
# Gradle startup script for POSIX generated by the Gradle wrapper.
#

app_path=$0

while
    APP_HOME=${app_path%"${app_path##*/}"}
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in
      /*)   app_path=$link ;;
      *)    app_path=$APP_HOME$link ;;
    esac
done

APP_BASE_NAME=${0##*/}
APP_HOME=$( cd "${APP_HOME:-./}" && pwd -P ) || exit

warn () { echo "$*" >&2; }
die () { warn; warn "$*"; warn; exit 1; } >&2

cygwin=false
msys=false
darwin=false
win32=false
case "$(uname)" in
  CYGWIN* )         cygwin=true  ;;
  Darwin* )         darwin=true  ;;
  MSYS* | MINGW*| MSYS2* )   msys=true; win32=true;;
  * )              ;;
esac

WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$WRAPPER_JAR" ]; then
    die "Unable to find $WRAPPER_JAR"
fi

if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/bin/java" ] ; then
        JAVACMD="$JAVA_HOME/bin/java"
    elif [ -x "$JAVA_HOME/jre/bin/java" ] ; then
        JAVACMD="$JAVA_HOME/jre/bin/java"
    else
        die "JAVA_HOME is set to an invalid directory: $JAVA_HOME"
    fi
else
    JAVACMD="java"
    if ! command -v "$JAVACMD" >/dev/null 2>&1 ; then
        die "JAVA_HOME is not set and no 'java' command could be found in PATH."
    fi
fi

if ! "$cygwin" && ! "$darwin" && ! "$win32" ; then
    MAX_FDS=$( ulimit -H -n ) || MAX_FDS=
    case $MAX_FDS in '' | 0 | *1024* ) MAX_FDS=1024 ;; esac
    ulimit -n "$MAX_FDS" || true
fi

set -- \
    "-Dorg.gradle.appname=$APP_BASE_NAME" \
    "-classpath" \
    "$WRAPPER_JAR" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"

exec "$JAVACMD" "$@"
